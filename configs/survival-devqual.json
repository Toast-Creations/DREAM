{
  "version": "1.4.0",
  "experiment": "survival",
  "phase": "development",
  "_note": "Test 3: 12 historical starting sets x 2 branches (develop/review first pass + common finalizer).",
  "model": {
    "path": "/model",
    "manifest": "/inputs/model-manifest.json",
    "dtype": "bfloat16",
    "device": "cuda",
    "enable_thinking": false
  },
  "data_path": "../data/survival-devqual-sources.jsonl",
  "output_dir": "../study-results/survival-devqual",
  "seeds": [
    11
  ],
  "survival": {
    "mode": "devqual",
    "branches": [
      "develop",
      "review"
    ],
    "order_seed": 20261101
  },
  "generation": {
    "temperature": 0.6,
    "high_temperature": 1.3,
    "top_p": 0.95,
    "top_k": 20
  },
  "steering": {
    "layer_index": -8,
    "vector_path": "/inputs/vectors/decategorization-vector.json",
    "random_vector_path": "/results/artifacts/random-qualify.json",
    "random_set_dir": "/inputs/vectors/random-set",
    "random_count": 9,
    "peak_strength": 0.2,
    "max_abs_strength": 0.4,
    "schedule": {
      "shape": "smooth",
      "onset_tokens": 50,
      "plateau_tokens": 100,
      "comedown_tokens": 200
    }
  },
  "limits": {
    "max_trials": 24,
    "max_seconds": 21600,
    "max_input_tokens": 8192,
    "max_new_tokens": 3072,
    "max_worlds": 12,
    "stage_input_tokens": {
      "ideation": 4096,
      "development": 8192,
      "final": 12288
    },
    "external_retries": 1,
    "loop_guard": {
      "window_tokens": 1200,
      "ngram": 16,
      "repeat_share": 0.8,
      "check_every": 16,
      "_note": "V1.3.3 calibrated guard (doc 19); a loop is recorded as finish_reason=loop, never resampled."
    }
  }
}